#!/usr/bin/env bash
# WHIS host-side wrapper. Auto-detects the LAN IP, regenerates certs only
# when the SAN set drifts, writes `.env.generated` for compose to consume,
# and shells out to `docker compose`. On macOS it also publishes
# `whis.local` via `dns-sd -P` because Docker Desktop's hidden Linux VM
# blocks the mDNS sidecar from reaching the LAN.
#
# Usage:
#   bin/whis up [...]        Build + start the dev stack (auto-detects LAN IP)
#   bin/whis down            Stop the stack and the mDNS publisher
#   bin/whis certs           Regenerate certs (host-side, with detected SANs)
#   bin/whis logs [service]  Tail compose logs
#   bin/whis nas up|down|... Same as above but uses docker-compose.nas.yml
#   bin/whis help            Show this help
#
# Env overrides (rarely needed):
#   WHIS_LAN_IP        Skip auto-detection; force a specific IPv4
#   WHIS_EXTRA_SANS    Comma-separated extra SANs baked into the cert
#   WHIS_MDNS_HOSTNAME Advertise under a different hostname (default: whis)
#   WHIS_NO_MDNS=1     Skip mDNS publishing entirely (Mac dns-sd or sidecar)

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "${REPO_ROOT}"

ENV_GENERATED="${REPO_ROOT}/.env.generated"
PID_FILE="${REPO_ROOT}/.whis-mdns.pid"

log() { printf '[whis] %s\n' "$*" >&2; }
err() { printf '[whis] error: %s\n' "$*" >&2; }

# ---------------------------------------------------------------------------
# OS + tooling detection
# ---------------------------------------------------------------------------

OS_NAME="$(uname -s)"
case "${OS_NAME}" in
    Darwin) IS_MAC=1; IS_LINUX=0 ;;
    Linux)  IS_MAC=0; IS_LINUX=1 ;;
    *)      IS_MAC=0; IS_LINUX=0 ;;
esac

check_compose_version() {
    local raw major minor
    if ! raw="$(docker compose version --short 2>/dev/null)"; then
        err "'docker compose' (v2.16+) is required but not installed."
        exit 1
    fi
    raw="${raw#v}"
    major="${raw%%.*}"
    minor="${raw#*.}"
    minor="${minor%%.*}"
    if [ "${major}" -lt 2 ] || { [ "${major}" -eq 2 ] && [ "${minor}" -lt 16 ]; }; then
        err "docker compose v2.16+ required (multi --env-file support); have ${raw}."
        exit 1
    fi
}

# ---------------------------------------------------------------------------
# LAN IP detection
# ---------------------------------------------------------------------------

ip_is_routable_private() {
    # Reject loopback, link-local, Docker bridge ranges (172.16/12), and
    # benchmarking blocks. Anything left should be a real RFC1918 LAN address.
    case "$1" in
        127.*|169.254.*|198.18.*|198.19.*|"")
            return 1 ;;
        172.1[6-9].*|172.2[0-9].*|172.3[0-1].*)
            return 1 ;;
        *)
            return 0 ;;
    esac
}

detect_lan_ip() {
    if [ -n "${WHIS_LAN_IP:-}" ]; then
        printf '%s' "${WHIS_LAN_IP}"
        return 0
    fi

    local ip=""
    if [ "${IS_MAC}" -eq 1 ]; then
        local iface
        iface="$(route -n get default 2>/dev/null | awk '/interface:/ {print $2}' || true)"
        if [ -n "${iface}" ]; then
            ip="$(ipconfig getifaddr "${iface}" 2>/dev/null || true)"
        fi
    elif [ "${IS_LINUX}" -eq 1 ]; then
        if command -v ip >/dev/null 2>&1; then
            ip="$(ip -4 -o route get 1.1.1.1 2>/dev/null \
                | awk '{for (i=1;i<=NF;i++) if ($i=="src") print $(i+1)}' || true)"
        fi
        if [ -z "${ip}" ] && command -v hostname >/dev/null 2>&1; then
            ip="$(hostname -I 2>/dev/null | awk '{print $1}' || true)"
        fi
    fi

    if ! ip_is_routable_private "${ip}"; then
        err "could not auto-detect a LAN IP (got: '${ip:-<empty>}')."
        err "set WHIS_LAN_IP=<your.lan.ip> and re-run."
        exit 1
    fi
    printf '%s' "${ip}"
}

# Mac extras: include the host's mDNS-advertised name (e.g. `bobs-mbp.local`)
# in the cert SANs so devices that resolve via macOS Bonjour (rather than the
# wrapper's `whis.local` publisher) still validate.
detect_mac_extra_sans() {
    [ "${IS_MAC}" -eq 1 ] || return 0
    local local_name
    local_name="$(scutil --get LocalHostName 2>/dev/null || true)"
    [ -n "${local_name}" ] || return 0
    printf '%s.local' "${local_name}"
}

# ---------------------------------------------------------------------------
# .env.generated writer (atomic)
# ---------------------------------------------------------------------------

write_env_generated() {
    local lan_ip="$1"
    local hostname="${WHIS_MDNS_HOSTNAME:-whis}"
    local tmp="${ENV_GENERATED}.tmp"
    cat > "${tmp}" <<EOF
# auto-generated by bin/whis — do not edit; rerun \`bin/whis up\` to refresh.
WHIS_LAN_IP=${lan_ip}
WHIS_MDNS_HOSTNAME=${hostname}
EOF
    mv "${tmp}" "${ENV_GENERATED}"
}

# ---------------------------------------------------------------------------
# Cert generation (delegates to the existing host-aware Node script)
# ---------------------------------------------------------------------------

regenerate_certs() {
    local lan_ip="$1"
    local extra_sans="${WHIS_EXTRA_SANS:-}"
    local mac_extra
    mac_extra="$(detect_mac_extra_sans || true)"
    if [ -n "${mac_extra}" ]; then
        if [ -n "${extra_sans}" ]; then
            extra_sans="${extra_sans},${mac_extra}"
        else
            extra_sans="${mac_extra}"
        fi
    fi

    log "regenerating cert SAN signature (lan=${lan_ip}; extras=${extra_sans:-<none>})"
    (
        cd "${REPO_ROOT}/frontend"
        WHIS_LAN_IP="${lan_ip}" \
        WHIS_EXTRA_SANS="${extra_sans}" \
        node scripts/generate-certs.js
    )
}

# ---------------------------------------------------------------------------
# Mac mDNS publisher (dns-sd -P)
# ---------------------------------------------------------------------------

publish_mdns_mac() {
    [ "${IS_MAC}" -eq 1 ] || return 0
    [ "${WHIS_NO_MDNS:-0}" = "1" ] && return 0

    local lan_ip="$1"
    local port="${2:-5173}"
    local hostname="${WHIS_MDNS_HOSTNAME:-whis}"

    stop_mdns_mac

    # `dns-sd -P` registers BOTH the SRV/TXT service record AND a hostname A
    # record (`whis.local` → ${lan_ip}). Backgrounded; PID stashed so we can
    # tear it down on `bin/whis down`.
    nohup dns-sd -P "${hostname}" _https._tcp local "${port}" \
        "${hostname}.local." "${lan_ip}" >/dev/null 2>&1 &
    local pid=$!
    printf '%s\n' "${pid}" > "${PID_FILE}"
    sleep 1
    if ! kill -0 "${pid}" 2>/dev/null; then
        rm -f "${PID_FILE}"
        log "warning: dns-sd publisher exited immediately; whis.local may not resolve."
        log "         (this is harmless if your Mac is named 'whis' and Bonjour already publishes it.)"
    else
        log "publishing mDNS: ${hostname}.local → ${lan_ip} (port ${port}, pid ${pid})"
    fi
}

stop_mdns_mac() {
    [ -f "${PID_FILE}" ] || return 0
    local pid
    pid="$(cat "${PID_FILE}" 2>/dev/null || true)"
    if [ -n "${pid}" ] && kill -0 "${pid}" 2>/dev/null; then
        kill "${pid}" 2>/dev/null || true
    fi
    rm -f "${PID_FILE}"
}

# ---------------------------------------------------------------------------
# Compose invocation
# ---------------------------------------------------------------------------

compose_args() {
    # Re-emit `--env-file` flags so `.env.generated` overrides `.env`. Compose
    # v2.16+ supports multiple --env-file; we gated on that in
    # check_compose_version above.
    local args=()
    if [ -f "${REPO_ROOT}/.env" ]; then
        args+=(--env-file "${REPO_ROOT}/.env")
    fi
    if [ -f "${ENV_GENERATED}" ]; then
        args+=(--env-file "${ENV_GENERATED}")
    fi
    printf '%s\n' "${args[@]}"
}

run_compose() {
    local mode="$1"; shift
    local compose_file=""
    case "${mode}" in
        dev) compose_file="" ;;
        nas) compose_file="-f docker-compose.nas.yml" ;;
    esac

    local profile_args=()
    if [ "${mode}" = "dev" ] \
        && [ "${IS_LINUX}" -eq 1 ] \
        && [ "${WHIS_NO_MDNS:-0}" != "1" ]; then
        profile_args+=(--profile mdns)
    fi

    local env_args=()
    while IFS= read -r line; do
        [ -n "${line}" ] && env_args+=("${line}")
    done < <(compose_args)

    # shellcheck disable=SC2086
    exec docker compose ${compose_file} "${env_args[@]}" "${profile_args[@]}" "$@"
}

# ---------------------------------------------------------------------------
# Subcommands
# ---------------------------------------------------------------------------

cmd_up() {
    check_compose_version
    local lan_ip
    lan_ip="$(detect_lan_ip)"
    log "detected host LAN IP: ${lan_ip}"
    write_env_generated "${lan_ip}"
    regenerate_certs "${lan_ip}"
    publish_mdns_mac "${lan_ip}" 5173
    log "starting compose…"
    run_compose dev up "$@"
}

cmd_down() {
    stop_mdns_mac
    run_compose dev down "$@"
}

cmd_certs() {
    local lan_ip
    lan_ip="$(detect_lan_ip)"
    log "detected host LAN IP: ${lan_ip}"
    write_env_generated "${lan_ip}"
    regenerate_certs "${lan_ip}"
}

cmd_logs() {
    run_compose dev logs -f "$@"
}

cmd_nas() {
    check_compose_version
    local sub="${1:-up}"; shift || true
    local lan_ip
    lan_ip="$(detect_lan_ip)"
    log "detected host LAN IP: ${lan_ip}"
    write_env_generated "${lan_ip}"
    case "${sub}" in
        up)   run_compose nas up -d "$@" ;;
        down) stop_mdns_mac; run_compose nas down "$@" ;;
        logs) run_compose nas logs -f "$@" ;;
        *)    run_compose nas "${sub}" "$@" ;;
    esac
}

cmd_help() {
    sed -n '2,21p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
}

# ---------------------------------------------------------------------------
# Dispatch
# ---------------------------------------------------------------------------

main() {
    local sub="${1:-help}"; shift || true
    case "${sub}" in
        up)    cmd_up "$@" ;;
        down)  cmd_down "$@" ;;
        certs) cmd_certs "$@" ;;
        logs)  cmd_logs "$@" ;;
        nas)   cmd_nas "$@" ;;
        help|-h|--help) cmd_help ;;
        *)
            err "unknown subcommand: ${sub}"
            cmd_help
            exit 2
            ;;
    esac
}

main "$@"
