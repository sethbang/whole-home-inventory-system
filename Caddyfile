# WHIS reverse proxy + SPA host — replaces the v2.3 nginx setup.
#
# Hostname is driven by WHIS_DOMAIN. When it resolves to a public address,
# Caddy auto-provisions a Let's Encrypt cert. When it's the `whis.local`
# default (or anything else non-public), Caddy falls back to its internal
# CA — the root cert lives at `/data/caddy/pki/authorities/local/root.crt`
# inside the container and should be installed on each household device.
#
# Traffic to the backend stays on the docker network, so we speak TLS with
# the self-signed cert from the shared `certs/` volume (generated by
# `frontend/scripts/generate-certs.js`); `tls_insecure_skip_verify` bypasses
# hostname/CA validation for that internal hop.
{
	email {$CADDY_ACME_EMAIL:admin@whis.local}
}

{$WHIS_DOMAIN:whis.local} {
	encode gzip zstd

	# Backend API + user uploads. Everything else is a SPA route.
	@backend path /api/* /uploads/*
	handle @backend {
		reverse_proxy https://backend:27182 {
			transport http {
				tls_insecure_skip_verify
			}
		}
	}

	# SPA: serve built assets, fall back to index.html for client-side routes.
	handle {
		root * /srv/frontend
		try_files {path} /index.html
		file_server

		# Long-cache hashed build assets.
		@hashedAssets path_regexp hashed ^/assets/
		header @hashedAssets Cache-Control "public, max-age=31536000, immutable"

		# Don't cache the app shell, service worker, or PWA manifest.
		@noCache path / /index.html /sw.js /registerSW.js /manifest.webmanifest /site.webmanifest
		header @noCache Cache-Control "no-cache"
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Tailwind + Vite inline a small amount of style; scripts are
		# self-hosted. connect-src self covers the same-origin API.
		Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; worker-src 'self' blob:; manifest-src 'self'; font-src 'self' data:; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		-Server
	}

	log {
		output stdout
		format console
	}
}
