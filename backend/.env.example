# WHIS backend environment template.
# Copy to backend/.env and fill in real values for local / container runs.

# --- Auth ---------------------------------------------------------------
# BYPASS_AUTH=true short-circuits auth for local development only.
# Leave false (the default) for any deployment reachable beyond localhost.
BYPASS_AUTH=false

# Required when BYPASS_AUTH=false. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Paths --------------------------------------------------------------
# In Docker, the compose file should point these at /app/backend/uploads etc.
# For local dev, relative paths are resolved against the backend/ working dir.
UPLOAD_DIR=./uploads
BACKUP_DIR=./backups

# Optional. Defaults to sqlite:///database/whis.db under the backend dir.
# For Postgres, use the v3 driver prefix:
#   DATABASE_URL=postgresql+psycopg://whis:whis@postgres:5432/whis
DATABASE_URL=

# --- Database connection pool (Postgres only; ignored on SQLite) -------
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE_SECONDS=1800

# --- Background job queue (v3.0) ---------------------------------------
# ARQ Redis-backed queue. When REDIS_URL is unset, backup create /
# restore and thumbnail generation run synchronously in-request — the
# default `docker compose up` posture. Set to activate the worker:
#   REDIS_URL=redis://redis:6379/0
# and start the worker service with `--profile worker`.
REDIS_URL=

# --- v3.1: Shared LLM layer --------------------------------------------
# Any OpenAI-compatible endpoint. Common targets:
#   https://openrouter.ai/api/v1    (structured outputs + web_search)
#   https://api.venice.ai/api/v1    (privacy-forward)
#   http://ollama:11434/v1          (local, no outbound)
#
# v3.2: every LLM_* / VISION_* / PRICING_* knob below can also be edited
# at runtime from the in-app /settings page (admin only). The DB-stored
# value overrides the env value when set; clearing the field in the UI
# falls back to env. The API key, when set in the UI, is encrypted at
# rest with a key derived from SECRET_KEY (HKDF-SHA256 → Fernet) — so
# don't change SECRET_KEY without re-saving the key in the UI, or the
# stored ciphertext becomes unreadable and the app falls back to env.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=google/gemini-2.5-flash

# Optional override consumed by `backend/scripts/seed_items.py` and
# `backend/scripts/test_venice_image.py`. When set, the seed scripts
# call Venice.ai's nano-banana-2 image endpoint directly and ignore
# LLM_BASE_URL. Leave unset if LLM_BASE_URL already points at Venice
# (LLM_API_KEY is reused in that case).
VENICE_API_KEY=

# Set this to a stronger reasoning model for pricing; defaults to LLM_MODEL.
LLM_PRICING_MODEL=
# Override the vision model. Some models combine image+structured-output
# poorly — Anthropic Sonnet 4.6 via OR's Azure provider reliably times
# out on this combination, for example. Defaults to LLM_MODEL when blank.
# Tested-good values on OpenRouter: google/gemini-2.5-flash,
# google/gemini-3-flash-preview.
LLM_VISION_MODEL=
LLM_TIMEOUT_SECONDS=90
# Privacy kill-switch: when false, LLM_BASE_URL must resolve to
# localhost / a private IP / a known container hostname. The app
# refuses to start otherwise.
LLM_ALLOW_CLOUD=true
# OR's response-healing plugin. Zero-cost safety net; leave on.
LLM_RESPONSE_HEALING=true

# --- v3.1: Vision auto-fill --------------------------------------------
VISION_ENABLED=false
VISION_MAX_IMAGES_PER_REQUEST=4
VISION_DAILY_COST_CAP_USD=5.0
# Never log image bytes; only sha256 hashes for debug correlation.
VISION_LOG_IMAGE_HASHES_ONLY=true

# --- v3.1: Item-value pricing ------------------------------------------
PRICING_ENABLED=false
# Provider priority. CSV. Set to just "llm" if you don't have eBay
# dev credentials, or "ebay" to disable the LLM pricing path.
PRICING_PROVIDERS=ebay,llm
PRICING_CACHE_DAYS=14
PRICING_MAX_SAMPLES=30
PRICING_MULTIPROVIDER=false
PRICING_DAILY_COST_CAP_USD=5.0
# Domain allow-list handed to OR web_search. CSV. Empty = no filter.
PRICING_WEB_SEARCH_DOMAINS=ebay.com,mercari.com,bonanza.com
PRICING_WEB_SEARCH_MAX_RESULTS=5
PRICING_WEB_SEARCH_MAX_TOTAL=20

# --- eBay Browse API (separate from the LLM web search) ----------------
# Apply for Application Keys at https://developer.ebay.com
EBAY_APP_ID=
EBAY_CERT_ID=
EBAY_MARKETPLACE_ID=EBAY_US
EBAY_ENVIRONMENT=production

# --- CORS ---------------------------------------------------------------
# Comma-separated list. HTTPS origins only — the app is HTTPS-only.
# Under docker-compose, this value is overridden by the compose file and
# auto-populated with the host's LAN IP via `bin/whis up` writing
# `.env.generated`. Edit here only for non-compose deployments.
CORS_ORIGINS=https://localhost:5173,https://whis.local:5173
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS,HEAD,PATCH
CORS_ALLOW_HEADERS=Content-Type,Authorization,Accept,Origin,X-Requested-With

# --- Upload limits ------------------------------------------------------
MAX_UPLOAD_BYTES=10485760
MAX_IMAGE_DIMENSION=8000

# --- Logging / debug ----------------------------------------------------
LOG_LEVEL=INFO
# DEBUG=true makes the global exception handler echo stack traces in HTTP
# responses. NEVER enable outside local development.
DEBUG=false

# LOG_FORMAT selects the structlog renderer. Leave blank to auto-pick:
# console when DEBUG=true, json otherwise. Override with "console" (human-
# readable) or "json" (line-delimited, machine-parseable).
LOG_FORMAT=

# --- OpenTelemetry ------------------------------------------------------
# Tracer provider installs lazily; exporter only spins up when enabled.
OTEL_ENABLED=false
OTEL_SERVICE_NAME=whis-backend
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
