# WHIS backend environment template.
# Copy to backend/.env and fill in real values for local / container runs.

# --- Auth ---------------------------------------------------------------
# BYPASS_AUTH=true short-circuits auth for local development only.
# Leave false (the default) for any deployment reachable beyond localhost.
BYPASS_AUTH=false

# Required when BYPASS_AUTH=false. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Paths --------------------------------------------------------------
# In Docker, the compose file should point these at /app/backend/uploads etc.
# For local dev, relative paths are resolved against the backend/ working dir.
UPLOAD_DIR=./uploads
BACKUP_DIR=./backups

# Optional. Defaults to sqlite:///database/whis.db under the backend dir.
# For Postgres, use the v3 driver prefix:
#   DATABASE_URL=postgresql+psycopg://whis:whis@postgres:5432/whis
DATABASE_URL=

# --- Database connection pool (Postgres only; ignored on SQLite) -------
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE_SECONDS=1800

# --- Background job queue (v3.0) ---------------------------------------
# ARQ Redis-backed queue. When REDIS_URL is unset, backup create /
# restore and thumbnail generation run synchronously in-request — the
# default `docker compose up` posture. Set to activate the worker:
#   REDIS_URL=redis://redis:6379/0
# and start the worker service with `--profile worker`.
REDIS_URL=

# --- CORS ---------------------------------------------------------------
# Comma-separated list. HTTPS origins only — the app is HTTPS-only.
CORS_ORIGINS=https://localhost:5173,https://192.168.1.122:5173
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS,HEAD,PATCH
CORS_ALLOW_HEADERS=Content-Type,Authorization,Accept,Origin,X-Requested-With

# --- Upload limits ------------------------------------------------------
MAX_UPLOAD_BYTES=10485760
MAX_IMAGE_DIMENSION=8000

# --- Logging / debug ----------------------------------------------------
LOG_LEVEL=INFO
# DEBUG=true makes the global exception handler echo stack traces in HTTP
# responses. NEVER enable outside local development.
DEBUG=false

# LOG_FORMAT selects the structlog renderer. Leave blank to auto-pick:
# console when DEBUG=true, json otherwise. Override with "console" (human-
# readable) or "json" (line-delimited, machine-parseable).
LOG_FORMAT=

# --- OpenTelemetry ------------------------------------------------------
# Tracer provider installs lazily; exporter only spins up when enabled.
OTEL_ENABLED=false
OTEL_SERVICE_NAME=whis-backend
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
